{
  "manifest_version": 3,
  "name": "YouTube Archive Clock",
  "version": "1.0.1",
  "description": "YouTubeの配信終了済みアーカイブに配信時の日時を表示します。",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-archive-clock@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}